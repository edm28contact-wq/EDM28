{
  "name": "edm-auto-mecano-du-dimanche",
  "version": "3.1.0",
  "private": true,
  "scripts": {
    "build": "npm run check:syntax",
    "check:syntax": "find . -type f -name '*.js' -not -path './node_modules/*' -print0 | xargs -0 -n1 node --check",
    "test:client": "node --test tests/client-flow.test.mjs tests/client-request-status.test.mjs tests/ai-message-draft.test.mjs tests/vehicle-required-fields.test.mjs tests/disbursement-workflow.test.mjs",
    "test:admin": "node --test tests/admin-flow.test.mjs tests/admin-transactional.test.mjs tests/admin-pwa.test.mjs tests/admin-pdf-models.test.mjs",
    "test:seo": "node --test tests/seo-public.test.mjs tests/seo-symptoms.test.mjs tests/seo-local.test.mjs",
    "test:recovery": "node --test tests/password-recovery.test.mjs tests/password-recovery-integration.test.mjs tests/password-recovery-errors.test.mjs",
    "test": "npm run check:syntax && npm run test:client && npm run test:admin && npm run test:seo && npm run test:recovery && npm run test:supplier-basket && npm run test:journey && npm run test:security",
    "dev": "vercel dev",
    "test:journey": "node --test tests/journey.test.mjs tests/journey-asset.test.mjs",
    "test:supplier-basket": "node --test tests/supplier-basket.test.mjs tests/supplier-basket-email.test.mjs tests/supplier-basket-admin.test.mjs",
    "test:security": "node --test tests/security-hardening.test.mjs"
  },
  "engines": {
    "node": "24.x"
  }
}
