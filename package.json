import React, { useMemo, useState } from 'react';
import { createRoot } from 'react-dom/client';
import { ArrowRight, ArrowLeft, CheckCircle2, Car, ClipboardList, Mail, Phone, ShieldCheck, Wrench } from 'lucide-react';
import './index.css';

const EDM_EMAIL = 'edm28.contact@gmail.com';

const partLevels = {
  eco: { label: 'Éco', multiplier: 0.9, note: 'Prix le plus accessible' },
  standard: { label: 'Standard', multiplier: 1, note: 'Bon rapport qualité / prix' },
  premium: { label: 'Premium', multiplier: 1.18, note: 'Marques reconnues / qualité supérieure' },
};

const services = [
  {
    id: 'controle_freinage',
    category: 'Freinage',
    name: 'Contrôle visuel freinage',
    description: 'Contrôle rapide des plaquettes, disques et état général visible.',
    labor: 29,
    partsMin: 0,
    partsMax: 0,
    duration: '20 min',
    selectablePartLevel: false,
  },
  {
    id: 'plaquettes_avant',
    category: 'Freinage',
    name: 'Montage plaquettes avant',
    description: 'Plaquettes fournies par le client. EDM AUTO peut aider à choisir les bonnes références.',
    labor: 69,
    partsMin: 35,
    partsMax: 55,
    duration: '45 à 60 min',
    selectablePartLevel: true,
  },
  {
    id: 'plaquettes_arriere',
    category: 'Freinage',
    name: 'Montage plaquettes arrière',
    description: 'Plaquettes fournies par le client. Selon véhicule et système de frein à main.',
    labor: 69,
    partsMin: 35,
    partsMax: 60,
    duration: '45 à 75 min',
    selectablePartLevel: true,
  },
  {
    id: 'disques_plaquettes_avant',
    category: 'Freinage',
    name: 'Montage disques + plaquettes avant',
    description: 'Disques et plaquettes fournis par le client, références à vérifier avant RDV.',
    labor: 109,
    partsMin: 115,
    partsMax: 155,
    duration: '1h15 à 1h45',
    selectablePartLevel: true,
  },
  {
    id: 'disques_plaquettes_arriere',
    category: 'Freinage',
    name: 'Montage disques + plaquettes arrière',
    description: 'Selon véhicule, frein de parking électrique ou classique à vérifier.',
    labor: 119,
    partsMin: 120,
    partsMax: 165,
    duration: '1h15 à 2h',
    selectablePartLevel: true,
  },
  {
    id: 'vidange',
    category: 'Entretien courant',
    name: 'Vidange moteur',
    description: 'Main-d’œuvre vidange. Filtre fourni ou réglé par le client. Huile estimée séparément.',
    labor: 69,
    partsMin: 8,
    partsMax: 15,
    oilLiters: 5,
    oilPricePerLiter: 12,
    duration: '45 à 60 min',
    selectablePartLevel: true,
  },
  {
    id: 'filtre_air',
    category: 'Entretien courant',
    name: 'Montage filtre à air',
    description: 'Filtre fourni par le client, compatibilité à vérifier.',
    labor: 19,
    partsMin: 12,
    partsMax: 25,
    duration: '10 à 20 min',
    selectablePartLevel: true,
  },
  {
    id: 'filtre_habitacle',
    category: 'Entretien courant',
    name: 'Montage filtre habitacle',
    description: 'Filtre fourni par le client. Accessibilité variable selon véhicule.',
    labor: 29,
    partsMin: 12,
    partsMax: 30,
    duration: '15 à 30 min',
    selectablePartLevel: true,
  },
  {
    id: 'montage_piece',
    category: 'Montage pièces',
    name: 'Montage pièce client',
    description: 'Pour une pièce fournie par le client. Tarif final confirmé après vérification.',
    labor: 39,
    partsMin: 0,
    partsMax: 0,
    duration: 'Sur devis selon pièce',
    selectablePartLevel: false,
  },
];

function euro(n) {
  return `${Math.round(n)} €`;
}

function clampText(value) {
  return String(value || '').trim();
}

function App() {
  const [step, setStep] = useState(0);
  const [client, setClient] = useState({ name: '', phone: '', email: '', plate: '', mileage: '', vehicle: '' });
  const [selected, setSelected] = useState({});
  const [partLevel, setPartLevel] = useState('standard');
  const level = partLevels[partLevel];

  const selectedServices = services.filter((service) => selected[service.id]);

  const totals = useMemo(() => {
    const labor = selectedServices.reduce((sum, service) => sum + service.labor, 0);
    const partsMin = selectedServices.reduce((sum, service) => {
      if (!service.selectablePartLevel) return sum + service.partsMin;
      return sum + service.partsMin * level.multiplier;
    }, 0);
    const partsMax = selectedServices.reduce((sum, service) => {
      if (!service.selectablePartLevel) return sum + service.partsMax;
      return sum + service.partsMax * level.multiplier;
    }, 0);
    const oil = selectedServices.reduce((sum, service) => sum + ((service.oilLiters || 0) * (service.oilPricePerLiter || 0)), 0);
    return {
      labor,
      partsMin,
      partsMax,
      oil,
      totalMin: labor + partsMin + oil,
      totalMax: labor + partsMax + oil,
    };
  }, [selectedServices, level]);

  const groupedServices = services.reduce((acc, service) => {
    acc[service.category] = acc[service.category] || [];
    acc[service.category].push(service);
    return acc;
  }, {});

  const updateClient = (field, value) => setClient((prev) => ({ ...prev, [field]: value }));

  const toggleService = (id) => {
    setSelected((prev) => ({ ...prev, [id]: !prev[id] }));
  };

  const mailBody = encodeURIComponent([
    'Nouvelle demande depuis le site EDM AUTO',
    '',
    'INFORMATIONS CLIENT',
    `Nom : ${client.name}`,
    `Téléphone : ${client.phone}`,
    `Email : ${client.email}`,
    `Immatriculation : ${client.plate}`,
    `Kilométrage : ${client.mileage}`,
    `Véhicule indiqué : ${client.vehicle}`,
    '',
    'SERVICES SÉLECTIONNÉS',
    ...selectedServices.map((service) => `- ${service.name} | Main-d’œuvre : ${euro(service.labor)}`),
    '',
    `Catégorie pièces choisie : ${level.label}`,
    `Main-d’œuvre totale EDM AUTO : ${euro(totals.labor)}`,
    `Pièces estimées : ${euro(totals.partsMin)} à ${euro(totals.partsMax)}`,
    `Huile estimée : ${euro(totals.oil)}`,
    `Total estimé : ${euro(totals.totalMin)} à ${euro(totals.totalMax)}`,
    '',
    'Validation demandée : vérifier les références pièces et confirmer le devis final avant RDV.',
  ].join('\n'));

  const subject = encodeURIComponent(`Nouvelle demande site EDM AUTO - ${client.plate || 'client'}`);
  const mailtoLink = `mailto:${EDM_EMAIL}?subject=${subject}&body=${mailBody}`;

  const canContinueInfo = clampText(client.name) && clampText(client.phone) && clampText(client.plate);

  return (
    <div className="app">
      <header className="topbar">
        <div className="brand"><span className="brand-mark">EDM</span><span>AUTO</span></div>
        <div className="top-pill">Spécialiste freinage</div>
      </header>

      <main>
        {step === 0 && (
          <section className="hero page-card">
            <div className="hero-badge"><ShieldCheck size={18} /> Freinage · Entretien courant · Montage pièces</div>
            <h1>Préparez votre RDV auto en quelques clics.</h1>
            <p>
              Vous achetez vos pièces, EDM AUTO vous aide à choisir les bonnes références compatibles avec votre véhicule,
              puis réalise le montage. Obtenez une estimation claire avant validation finale.
            </p>
            <button className="primary big" onClick={() => setStep(1)}>
              Préparer mon RDV <ArrowRight size={20} />
            </button>
            <div className="hero-grid">
              <div><Wrench /><strong>Freinage</strong><span>Plaquettes, disques, contrôle</span></div>
              <div><Car /><strong>Vidange</strong><span>Service annexe selon véhicule</span></div>
              <div><ClipboardList /><strong>Pièces</strong><span>Éco, Standard ou Premium</span></div>
            </div>
          </section>
        )}

        {step === 1 && (
          <section className="page-card">
            <StepTitle step="1/4" title="Vos informations" subtitle="Ces informations servent à préparer la demande et vérifier le véhicule." />
            <div className="form-grid">
              <Field label="Nom complet" value={client.name} onChange={(v) => updateClient('name', v)} placeholder="Ex : Enguerrand Danglade" />
              <Field label="Téléphone" value={client.phone} onChange={(v) => updateClient('phone', v)} placeholder="Ex : 06 12 34 56 78" />
              <Field label="Email" value={client.email} onChange={(v) => updateClient('email', v)} placeholder="exemple@mail.com" />
              <Field label="Immatriculation" value={client.plate} onChange={(v) => updateClient('plate', v.toUpperCase())} placeholder="AB-123-CD" />
              <Field label="Kilométrage" value={client.mileage} onChange={(v) => updateClient('mileage', v)} placeholder="Ex : 112 500 km" />
              <Field label="Véhicule si connu" value={client.vehicle} onChange={(v) => updateClient('vehicle', v)} placeholder="Ex : Peugeot 308 1.6 BlueHDi" />
            </div>
            <NavButtons back={() => setStep(0)} next={() => setStep(2)} nextDisabled={!canContinueInfo} />
          </section>
        )}

        {step === 2 && (
          <section className="page-card wide">
            <StepTitle step="2/4" title="Choisissez vos services" subtitle="La main-d’œuvre est fixe. Les pièces restent à la charge du client." />
            <div className="level-card">
              <h3>Catégorie de pièces souhaitée</h3>
              <div className="level-grid">
                {Object.entries(partLevels).map(([key, item]) => (
                  <button key={key} className={`level ${partLevel === key ? 'active' : ''}`} onClick={() => setPartLevel(key)}>
                    <strong>{item.label}</strong>
                    <span>{item.note}</span>
                  </button>
                ))}
              </div>
            </div>

            <div className="services-list">
              {Object.entries(groupedServices).map(([category, list]) => (
                <div key={category} className="service-group">
                  <h3>{category}</h3>
                  {list.map((service) => {
                    const min = service.selectablePartLevel ? service.partsMin * level.multiplier : service.partsMin;
                    const max = service.selectablePartLevel ? service.partsMax * level.multiplier : service.partsMax;
                    const oil = (service.oilLiters || 0) * (service.oilPricePerLiter || 0);
                    return (
                      <button key={service.id} className={`service-card ${selected[service.id] ? 'selected' : ''}`} onClick={() => toggleService(service.id)}>
                        <div className="check">{selected[service.id] ? <CheckCircle2 size={24} /> : <span />}</div>
                        <div className="service-main">
                          <strong>{service.name}</strong>
                          <p>{service.description}</p>
                          <small>Durée estimée : {service.duration}</small>
                        </div>
                        <div className="price-box">
                          <span>Main-d’œuvre</span>
                          <strong>{euro(service.labor)}</strong>
                          {max > 0 && <em>Pièces : {euro(min)} à {euro(max)}</em>}
                          {oil > 0 && <em>Huile estimée : {euro(oil)}</em>}
                        </div>
                      </button>
                    );
                  })}
                </div>
              ))}
            </div>
            <NavButtons back={() => setStep(1)} next={() => setStep(3)} nextDisabled={selectedServices.length === 0} />
          </section>
        )}

        {step === 3 && (
          <section className="page-card wide">
            <StepTitle step="3/4" title="Votre estimation" subtitle="Estimation indicative avant vérification des références pièces." />
            <div className="summary-layout">
              <div className="summary-card">
                <h3>Client / véhicule</h3>
                <InfoLine label="Nom" value={client.name} />
                <InfoLine label="Téléphone" value={client.phone} />
                <InfoLine label="Email" value={client.email || 'Non renseigné'} />
                <InfoLine label="Immatriculation" value={client.plate} />
                <InfoLine label="Kilométrage" value={client.mileage || 'Non renseigné'} />
                <InfoLine label="Véhicule" value={client.vehicle || 'À vérifier'} />
              </div>
              <div className="summary-card highlight">
                <h3>Total estimé</h3>
                <div className="total-range">{euro(totals.totalMin)} à {euro(totals.totalMax)}</div>
                <InfoLine label="Main-d’œuvre EDM AUTO" value={euro(totals.labor)} />
                <InfoLine label="Pièces estimées" value={`${euro(totals.partsMin)} à ${euro(totals.partsMax)}`} />
                <InfoLine label="Huile estimée" value={euro(totals.oil)} />
                <InfoLine label="Catégorie pièces" value={level.label} />
              </div>
            </div>
            <div className="selected-list">
              <h3>Services sélectionnés</h3>
              {selectedServices.map((service) => <div key={service.id}><span>{service.name}</span><strong>{euro(service.labor)}</strong></div>)}
            </div>
            <p className="notice">
              Cette estimation ne vaut pas devis définitif. EDM AUTO vérifie les références compatibles avec votre véhicule avant confirmation du RDV.
            </p>
            <NavButtons back={() => setStep(2)} next={() => setStep(4)} />
          </section>
        )}

        {step === 4 && (
          <section className="page-card">
            <StepTitle step="4/4" title="Envoyer la demande" subtitle="La demande arrive par mail à EDM AUTO pour validation humaine." />
            <div className="send-card">
              <Mail size={42} />
              <h3>Votre demande est prête.</h3>
              <p>
                Cliquez sur le bouton ci-dessous pour ouvrir votre application mail avec la demande déjà remplie.
                EDM AUTO la vérifiera avant de confirmer le tarif final.
              </p>
              <a className="primary big" href={mailtoLink}>Envoyer ma demande <Mail size={20} /></a>
            </div>
            <div className="mini-actions">
              <button className="secondary" onClick={() => setStep(3)}><ArrowLeft size={18} /> Retour estimation</button>
              <button className="ghost" onClick={() => { setStep(0); setSelected({}); }}>Nouvelle simulation</button>
            </div>
          </section>
        )}
      </main>

      <footer>
        <span>EDM AUTO</span>
        <span>Estimation indicative · Validation finale avant intervention</span>
        <span><Phone size={14} /> Contact via demande RDV</span>
      </footer>
    </div>
  );
}

function StepTitle({ step, title, subtitle }) {
  return (
    <div className="step-title">
      <span>{step}</span>
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>
  );
}

function Field({ label, value, onChange, placeholder }) {
  return (
    <label className="field">
      <span>{label}</span>
      <input value={value} onChange={(event) => onChange(event.target.value)} placeholder={placeholder} />
    </label>
  );
}

function NavButtons({ back, next, nextDisabled }) {
  return (
    <div className="nav-buttons">
      <button className="secondary" onClick={back}><ArrowLeft size={18} /> Retour</button>
      <button className="primary" onClick={next} disabled={nextDisabled}>Continuer <ArrowRight size={18} /></button>
    </div>
  );
}

function InfoLine({ label, value }) {
  return <div className="info-line"><span>{label}</span><strong>{value}</strong></div>;
}

createRoot(document.getElementById('root')).render(<App />);
