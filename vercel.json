{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm test",
  "env": {
    "RESEND_FROM_EMAIL": "EDM28 <onboarding@resend.dev>",
    "RESEND_TO_EMAIL": "contact@edm28.fr"
  },
  "functions": {
    "api/app.js": {
      "includeFiles": "index.html"
    },
    "api/admin.js": {
      "includeFiles": "{admin.html,admin-core.js,admin-transactional.js}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/admin-sw.js",
      "headers": [
        { "key": "Content-Type", "value": "text/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/admin" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/admin-manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/admin-offline.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ],
  "routes": [
    { "src": "/robots.txt", "dest": "/api/app?seo=robots" },
    { "src": "/sitemap.xml", "dest": "/api/app?seo=sitemap" },
    { "src": "/symptomes", "dest": "/api/app?seo=symptom&slug=symptomes" },
    { "src": "/freinage/freins-qui-grincent", "dest": "/api/app?seo=symptom&slug=freinage/freins-qui-grincent" },
    { "src": "/freinage/vibrations-au-freinage", "dest": "/api/app?seo=symptom&slug=freinage/vibrations-au-freinage" },
    { "src": "/freinage/pedale-de-frein-molle", "dest": "/api/app?seo=symptom&slug=freinage/pedale-de-frein-molle" },
    { "src": "/liaison-au-sol/claquement-train-avant", "dest": "/api/app?seo=symptom&slug=liaison-au-sol/claquement-train-avant" },
    { "src": "/freinage", "dest": "/api/app?seo=page&slug=freinage" },
    { "src": "/freinage/plaquettes-de-frein", "dest": "/api/app?seo=page&slug=freinage/plaquettes-de-frein" },
    { "src": "/freinage/disques-de-frein", "dest": "/api/app?seo=page&slug=freinage/disques-de-frein" },
    { "src": "/freinage/liquide-de-frein", "dest": "/api/app?seo=page&slug=freinage/liquide-de-frein" },
    { "src": "/liaison-au-sol", "dest": "/api/app?seo=page&slug=liaison-au-sol" },
    { "src": "/liaison-au-sol/triangles", "dest": "/api/app?seo=page&slug=liaison-au-sol/triangles" },
    { "src": "/liaison-au-sol/direction", "dest": "/api/app?seo=page&slug=liaison-au-sol/direction" },
    { "src": "/prestations", "dest": "/api/app?seo=page&slug=prestations" },
    { "src": "/tarifs", "dest": "/api/app?seo=page&slug=tarifs" },
    { "src": "/fonctionnement", "dest": "/api/app?seo=page&slug=fonctionnement" },
    { "src": "/transparence", "dest": "/api/app?seo=page&slug=transparence" },
    { "src": "/a-propos", "dest": "/api/app?seo=page&slug=a-propos" },
    { "src": "/contact", "dest": "/api/app?seo=page&slug=contact" },
    { "src": "/index.html", "dest": "/api/app" },
    { "src": "/", "dest": "/api/app" },
    { "src": "/admin", "dest": "/api/admin" },
    { "src": "/admin.html", "dest": "/api/admin" },
    { "src": "/api/send-notification", "dest": "/api/health" },
    { "handle": "filesystem" }
  ]
}
